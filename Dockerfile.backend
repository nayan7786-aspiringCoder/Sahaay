FROM python:3.12-slim

WORKDIR /app/backend

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

EXPOSE 8001
# server.py exposes both `flask_app` (WSGI) and `app` (ASGI via WsgiToAsgi).
CMD ["gunicorn", "-w", "2", "-b", "0.0.0.0:8001", "server:flask_app"]
