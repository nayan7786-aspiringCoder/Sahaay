# Copy to backend/.env and fill in. NEVER commit the real file.
# ---- storage ----
# auto   → Google Sheets when credentials below are set (and reachable), else SQLite
# sheets → force Sheets (errors surface as 502 with a clear message)
# sqlite → force the local offline store
STORE_MODE=auto

# Google Sheets API (service account):
#   1. console.cloud.google.com → enable "Google Sheets API"
#   2. create a service account + JSON key
#   3. share your spreadsheet with the service-account email as Editor
#   4. run:  python setup_sheets.py   (creates Providers/Bookings tabs)
GOOGLE_SHEETS_ID=
# Raw JSON string, or a path to the key file (relative to backend/):
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- app ----
CORS_ORIGINS=*
APP_TIMEZONE=Asia/Kolkata
DATA_DIR=./data
SQLITE_PATH=./data/sahaay.db
